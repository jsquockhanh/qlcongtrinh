rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsResource() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function createsForSelf() { return signedIn() && request.resource.data.ownerId == request.auth.uid; }
    match /projects/{id} {
      allow read, delete: if ownsResource();
      allow create: if createsForSelf();
      allow update: if ownsResource() && request.resource.data.ownerId == request.auth.uid;
    }
    match /parties/{id} {
      allow read, delete: if ownsResource();
      allow create: if createsForSelf();
      allow update: if ownsResource() && request.resource.data.ownerId == request.auth.uid;
    }
    match /expenses/{id} {
      allow read, delete: if ownsResource();
      allow create: if createsForSelf();
      allow update: if ownsResource() && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
